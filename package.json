{
  "name": "@vibecontrols/vibe-plugin-security-package-publish",
  "version": "2026.528.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Cosign signing + SLSA provenance for the package.publish lifecycle stage. Signs the published artifact (keyless via Fulcio OIDC when available, or with input.config.cosignKey for key-based) and emits an intoto+json SLSA provenance document. Registers as a security.sbom provider with @vibecontrols/vibe-plugin-security.",
  "engines": {
    "bun": ">=1.4.4"
  },
  "author": {
    "name": "Vignesh T.V",
    "url": "https://github.com/tvvignesh"
  },
  "license": "MIT",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify-syntax --minify-whitespace --external elysia --external @vibecontrols/vibe-plugin-security --external @vibecontrols/plugin-sdk && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "type:check": "boff gate -- bun check --no-pretty",
    "test": "bun test",
    "clean": "rimraf dist",
    "prebuild": "bun run clean",
    "prepublishOnly": "bun run build",
    "sanity": "boff sanity",
    "sanity:force": "boff sanity --force",
    "audit": "bun audit --audit-level=high"
  },
  "dependencies": {
    "@vibecontrols/plugin-sdk": "2026.527.1",
    "@vibecontrols/vibe-plugin-security": "2026.528.1"
  },
  "devDependencies": {
    "@burdenoff/toolchain": "2026.1107.14",
    "@types/bun": "^1.4.4",
    "eslint": "^9.39.5",
    "knip": "^6.44.1",
    "rimraf": "^6.1.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@vibecontrols/agent": ">=2026.428.0"
  },
  "peerDependenciesMeta": {
    "@vibecontrols/agent": {
      "optional": true
    }
  },
  "keywords": [
    "vibecontrols",
    "vibe",
    "vibe-plugin",
    "security",
    "cosign",
    "slsa",
    "provenance",
    "supply-chain",
    "package-publish",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Algoshred/vibe-plugin-security-package-publish.git"
  },
  "bugs": {
    "url": "https://github.com/Algoshred/vibe-plugin-security-package-publish/issues"
  },
  "homepage": "https://vibecontrols.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.4",
  "boff": {
    "type": "plugin",
    "sanity": {
      "steps": [
        "format",
        "lint",
        "typecheck",
        "build",
        "test",
        "knip"
      ]
    }
  },
  "overrides": {
    "minimatch@3>brace-expansion": "^1.1.21",
    "elysia": "^1.4.30"
  }
}
